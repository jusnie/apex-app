<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.APEX" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/apex_black</item>
        <item name="android:colorBackground">@color/apex_black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!--
      Android 12+ SplashScreen theme. Enforces pure black background and APEX emblem
      before transitioning seamlessly into Theme.APEX.
    -->
    <style name="Theme.APEX.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/apex_black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.APEX</item>
    </style>
</resources>
